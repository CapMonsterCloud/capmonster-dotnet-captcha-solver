<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Zennolab.CapMonsterCloud.Client</AssemblyName>
    <RootNamespace>Zennolab.CapMonsterCloud</RootNamespace>
    <Company>CapMonster Cloud</Company>
    <Authors>CapMonster Cloud</Authors>
    <Description>Official CapMonster Cloud C# and .NET SDK: captcha solver and captcha bypass for reCAPTCHA, Cloudflare Turnstile, DataDome and GeeTest. A 2captcha and capsolver alternative.</Description>
    <Copyright>CapMonster Cloud, 2026</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageTags>capmonster capmonster-cloud captcha captcha-solver captcha-bypass recaptcha cloudflare-turnstile geetest datadome web-scraping 2captcha-alternative capsolver-alternative</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/CapMonsterCloud/capmonster-dotnet-captcha-solver</RepositoryUrl>
    <PackageProjectUrl>https://github.com/CapMonsterCloud/capmonster-dotnet-captcha-solver</PackageProjectUrl>
    <Version>4.0.2</Version>
    <PackageReleaseNotes>Updated package metadata and README (no code changes).</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CapMonsterCloud.Client.IntegrationTests" />
  </ItemGroup>

</Project>
